---
import { type Lang, useTranslations } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const stats = [
  { value: 10000, suffix: '+', display: t('hero.stat1'), label: t('hero.stat1Label') },
  { value: 5000, suffix: '+', display: t('hero.stat2'), label: t('hero.stat2Label') },
  { value: 4, suffix: ' Fleet', display: t('hero.stat3'), label: t('hero.stat3Label') },
  { value: 24, suffix: '/7', display: t('hero.stat4'), label: t('hero.stat4Label') },
];
---

<section class="stats-ribbon-section">
  <div class="container">
    <div class="stats-panel-bar surface-panel">
      {stats.map((stat) => (
        <div class="stat-unit">
          <div class="stat-number-wrap">
            <span class="stat-number text-brand" data-target={stat.value}>{stat.display}</span>
          </div>
          <span class="stat-caption text-muted">{stat.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .stats-ribbon-section {
    position: relative;
    margin-top: -2.5rem;
    z-index: 10;
  }

  .stats-panel-bar {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    padding: 2.25rem 2rem;
    background: #ffffff;
    border: 1px solid var(--bb-border);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.05);
  }

  .stat-unit {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    border-right: 1px solid var(--bb-border);
  }

  .stat-unit:last-child {
    border-right: none;
  }

  .stat-number {
    font-size: clamp(2rem, 3.2vw, 2.6rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--bb-red-600);
  }

  .stat-caption {
    font-size: 0.92rem;
    margin-top: 0.35rem;
    font-weight: 500;
    color: var(--bb-text-muted);
  }

  @media (max-width: 850px) {
    .stats-panel-bar {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
    .stat-unit:nth-child(2) {
      border-right: none;
    }
  }

  @media (max-width: 500px) {
    .stats-panel-bar {
      grid-template-columns: 1fr;
      padding: 1.75rem 1.25rem;
    }
    .stat-unit {
      border-right: none;
      border-bottom: 1px solid var(--bb-border);
      padding-bottom: 1.25rem;
    }
    .stat-unit:last-child {
      border-bottom: none;
      padding-bottom: 0;
    }
  }
</style>
