---
interface Props {
  src: string;
  width?: string;
  height?: string;
  loop?: boolean;
  autoplay?: boolean;
  class?: string;
}

const {
  src,
  width = '100%',
  height = '320px',
  loop = true,
  autoplay = true,
  class: className = '',
} = Astro.props;
---

<div
  class:list={['lottie-player-wrapper', className]}
  data-src={src}
  data-width={width}
  data-height={height}
  data-loop={String(loop)}
  data-autoplay={String(autoplay)}
  style={`width: ${width}; min-height: ${height};`}
>
  <div class="lottie-skeleton" style={`height: ${height};`}></div>
</div>

<style>
  .lottie-player-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }

  .lottie-skeleton {
    width: 100%;
    background: radial-gradient(circle at center, rgba(239, 68, 68, 0.08) 0%, transparent 70%);
    border-radius: var(--bb-radius-md);
  }
</style>

<script>
  import '@lottiefiles/dotlottie-wc';

  function initLottiePlayers() {
    const wrappers = document.querySelectorAll<HTMLElement>('.lottie-player-wrapper');

    wrappers.forEach((wrapper) => {
      if (wrapper.dataset.initialized) return;
      wrapper.dataset.initialized = 'true';

      const src = wrapper.dataset.src || '';
      const loop = wrapper.dataset.loop === 'true';
      const autoplay = wrapper.dataset.autoplay === 'true';

      const player = document.createElement('dotlottie-wc');
      player.setAttribute('src', src);
      if (loop) player.setAttribute('loop', '');
      if (autoplay) player.setAttribute('autoplay', '');
      player.style.width = '100%';
      player.style.height = '100%';

      wrapper.innerHTML = '';
      wrapper.appendChild(player);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initLottiePlayers);
  } else {
    initLottiePlayers();
  }
</script>
