---
import { type Lang, useTranslations } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const vehicles = [
  {
    id: 'motorcycle',
    model: '/models/motorcycle.glb',
    icon: '/icons/ui/bike.svg',
    name: t('vehicles.motorcycle'),
    desc: t('vehicles.motorcycleDesc'),
    capacity: lang === 'ne' ? '१ जना यात्रु' : '1 Passenger',
    speed: lang === 'ne' ? 'छिटो र छरितो' : 'Fast and Agile',
    fare: lang === 'ne' ? 'रु. ४० बाट सुरु' : 'From NPR 40',
  },
  {
    id: 'scooter',
    model: '/models/scooter.glb',
    icon: '/icons/ui/zap.svg',
    name: t('vehicles.scooter'),
    desc: t('vehicles.scooterDesc'),
    capacity: lang === 'ne' ? '१ जना यात्रु' : '1 Passenger',
    speed: lang === 'ne' ? 'सहज नगर यात्रा' : 'Smooth City Hop',
    fare: lang === 'ne' ? 'रु. ४० बाट सुरु' : 'From NPR 40',
  },
  {
    id: 'auto-rickshaw',
    model: '/models/auto-rickshaw.glb',
    icon: '/icons/ui/truck.svg',
    name: t('vehicles.rickshaw'),
    desc: t('vehicles.rickshawDesc'),
    capacity: lang === 'ne' ? '३ जना यात्रु' : '3 Passengers',
    speed: lang === 'ne' ? 'सामान सहित यात्रा' : 'Luggage Friendly',
    fare: lang === 'ne' ? 'रु. ७० बाट सुरु' : 'From NPR 70',
  },
  {
    id: 'car',
    model: '/models/car.glb',
    icon: '/icons/ui/car.svg',
    name: t('vehicles.car'),
    desc: t('vehicles.carDesc'),
    capacity: lang === 'ne' ? '४ जना यात्रु' : '4 Passengers',
    speed: lang === 'ne' ? 'आरामदायी लामो यात्रा' : 'Long Distance Comfort',
    fare: lang === 'ne' ? 'रु. १५० बाट सुरु' : 'From NPR 150',
  },
];
---

<section class="section vehicle-showcase-section" id="vehicles">
  <div class="container">
    <div class="text-center section-header">
      <span class="category-label">{t('vehicles.badge')}</span>
      <h2 class="heading-lg" style="margin-top: 0.5rem;">{t('vehicles.title')}</h2>
      <p class="lead-text" style="max-width: 680px; margin: 0.85rem auto 0;">
        {t('vehicles.lead')}
      </p>
    </div>

    <!-- Clean Vehicle Selection Tabs -->
    <div class="vehicle-tab-bar" role="tablist" aria-label="Vehicle options">
      {vehicles.map((v, i) => (
        <button
          class:list={['vehicle-tab-btn', { active: i === 0 }]}
          data-vehicle-id={v.id}
          data-model-url={v.model}
          data-name={v.name}
          data-desc={v.desc}
          data-capacity={v.capacity}
          data-speed={v.speed}
          data-fare={v.fare}
          role="tab"
          aria-selected={i === 0 ? 'true' : 'false'}
          id={`tab-${v.id}`}
        >
          <img src={v.icon} alt="" width="20" height="20" class="tab-icon" />
          <span class="tab-label">{v.name}</span>
        </button>
      ))}
    </div>

    <!-- 3D Viewer and Specs Display -->
    <div class="showcase-display-grid">
      <!-- 3D Canvas Box -->
      <div class="viewer-stage" id="showcase-3d-stage">
        <div class="stage-loader" id="showcase-loader">
          <div class="spinner"></div>
          <span>3D मोडेल लोड हुँदैछ...</span>
        </div>
        <canvas id="showcase-canvas"></canvas>
        <div class="stage-tag" id="active-vehicle-badge">
          <img src="/icons/ui/bike.svg" alt="" width="16" height="16" id="badge-icon" class="badge-icon" />
          <span id="badge-text">{vehicles[0].name}</span>
        </div>
      </div>

      <!-- Specs & Details Panel -->
      <div class="vehicle-info-panel surface-panel">
        <h3 class="heading-md" id="vehicle-title">{vehicles[0].name}</h3>
        <p class="vehicle-desc text-muted" id="vehicle-desc">{vehicles[0].desc}</p>

        <div class="spec-matrix">
          <div class="spec-tile">
            <span class="spec-label">{lang === 'ne' ? 'सवारी क्षमता' : 'Seating Capacity'}</span>
            <span class="spec-value" id="spec-capacity">{vehicles[0].capacity}</span>
          </div>
          <div class="spec-tile">
            <span class="spec-label">{lang === 'ne' ? 'यात्रा प्रकार' : 'Ride Character'}</span>
            <span class="spec-value" id="spec-speed">{vehicles[0].speed}</span>
          </div>
          <div class="spec-tile">
            <span class="spec-label">{lang === 'ne' ? 'अनुमानित भाडा' : 'Estimated Base Fare'}</span>
            <span class="spec-value text-brand" id="spec-fare">{vehicles[0].fare}</span>
          </div>
          <div class="spec-tile">
            <span class="spec-label">{lang === 'ne' ? 'उपलब्धता' : 'Service Status'}</span>
            <span class="spec-value" style="color: #16a34a;">
              {lang === 'ne' ? 'सिन्धुलीमा सक्रिय' : 'Active in Sindhuli'}
            </span>
          </div>
        </div>

        <div class="panel-action">
          <a href="https://play.google.com/store/apps/details?id=com.bataibato.app" target="_blank" rel="noopener noreferrer" class="btn btn-primary">
            <img src="/icons/ui/download.svg" alt="" width="18" height="18" style="filter: brightness(0) invert(1);" />
            <span>{lang === 'ne' ? 'राइड बुक गर्न एप खोल्नुहोस्' : 'Book on BataiBato App'}</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .vehicle-showcase-section {
    background: #f8fafc;
    border-top: 1px solid var(--bb-border);
    border-bottom: 1px solid var(--bb-border);
  }

  .vehicle-tab-bar {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
    margin-bottom: 2.5rem;
  }

  .vehicle-tab-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    background: #ffffff;
    border: 1px solid var(--bb-border);
    padding: 0.7rem 1.35rem;
    border-radius: var(--bb-radius-full);
    color: var(--bb-text);
    font-size: 0.95rem;
    font-weight: 600;
    transition: all 0.2s ease;
    box-shadow: var(--bb-shadow-subtle);
  }

  .vehicle-tab-btn:hover {
    border-color: var(--bb-red-600);
    transform: translateY(-2px);
  }

  .vehicle-tab-btn.active {
    background: #ffffff;
    border-color: var(--bb-red-600);
    color: var(--bb-red-600);
    box-shadow: 0 2px 8px rgba(220, 38, 38, 0.15);
  }

  .vehicle-tab-btn.active .tab-icon {
    filter: invert(19%) sepia(87%) saturate(5412%) hue-rotate(352deg) brightness(92%) contrast(92%);
  }

  .tab-icon {
    width: 18px;
    height: 18px;
    opacity: 0.8;
  }

  .showcase-display-grid {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: 2rem;
    align-items: center;
  }

  .viewer-stage {
    position: relative;
    width: 100%;
    height: 440px;
    background: radial-gradient(circle at center, #ffffff 0%, #edf2f7 100%);
    border: 1px solid var(--bb-border);
    border-radius: var(--bb-radius-lg);
    overflow: hidden;
    box-shadow: var(--bb-shadow-panel);
  }

  #showcase-canvas {
    width: 100%;
    height: 100%;
    cursor: grab;
  }

  #showcase-canvas:active {
    cursor: grabbing;
  }

  .stage-loader {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    color: var(--bb-text-muted);
    font-size: 0.9rem;
    background: rgba(255, 255, 255, 0.85);
    transition: opacity 0.3s;
    pointer-events: none;
  }

  .stage-loader.hidden {
    opacity: 0;
  }

  .spinner {
    width: 34px;
    height: 34px;
    border: 3px solid #fee2e2;
    border-top-color: var(--bb-red-600);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  .stage-tag {
    position: absolute;
    top: 16px;
    left: 16px;
    display: flex;
    align-items: center;
    gap: 0.45rem;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(8px);
    border: 1px solid var(--bb-border);
    padding: 0.4rem 0.85rem;
    border-radius: var(--bb-radius-full);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--bb-text);
    box-shadow: var(--bb-shadow-subtle);
  }

  .badge-icon {
    filter: invert(19%) sepia(87%) saturate(5412%) hue-rotate(352deg) brightness(92%) contrast(92%);
  }

  .vehicle-info-panel {
    background: #ffffff;
    border: 1px solid var(--bb-border);
    border-radius: var(--bb-radius-lg);
    padding: 2.25rem 2rem;
  }

  .vehicle-desc {
    margin-top: 0.65rem;
    margin-bottom: 1.75rem;
    line-height: 1.6;
    font-size: 1rem;
  }

  .spec-matrix {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .spec-tile {
    background: #f8fafc;
    border: 1px solid var(--bb-border);
    padding: 0.85rem 1.15rem;
    border-radius: var(--bb-radius-md);
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .spec-label {
    font-size: 0.8rem;
    color: var(--bb-text-muted);
    font-weight: 500;
  }

  .spec-value {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--bb-text);
  }

  .panel-action {
    display: flex;
  }

  @media (max-width: 900px) {
    .showcase-display-grid {
      grid-template-columns: 1fr;
    }
    .viewer-stage {
      height: 340px;
    }
  }
</style>

<script>
  import * as THREE from 'three';
  import { GLTFLoader } from 'three/examples/jsm/loaders/GLTFLoader.js';
  import { DRACOLoader } from 'three/examples/jsm/loaders/DRACOLoader.js';
  import { OrbitControls } from 'three/examples/jsm/controls/OrbitControls.js';

  function initShowcaseViewer() {
    const stage = document.getElementById('showcase-3d-stage');
    const canvas = document.getElementById('showcase-canvas') as HTMLCanvasElement | null;
    const loaderElem = document.getElementById('showcase-loader');
    const tabs = document.querySelectorAll<HTMLButtonElement>('.vehicle-tab-btn');

    if (!stage || !canvas) return;

    const titleElem = document.getElementById('vehicle-title');
    const descElem = document.getElementById('vehicle-desc');
    const capElem = document.getElementById('spec-capacity');
    const speedElem = document.getElementById('spec-speed');
    const fareElem = document.getElementById('spec-fare');
    const badgeText = document.getElementById('badge-text');
    const badgeIcon = document.getElementById('badge-icon') as HTMLImageElement | null;

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(45, stage.clientWidth / stage.clientHeight, 0.1, 100);
    camera.position.set(3.2, 1.6, 3.2);

    const renderer = new THREE.WebGLRenderer({
      canvas,
      antialias: true,
      alpha: true,
      powerPreference: 'high-performance',
    });
    renderer.setSize(stage.clientWidth, stage.clientHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.2;

    const controls = new OrbitControls(camera, canvas);
    controls.enableDamping = true;
    controls.dampingFactor = 0.05;
    controls.autoRotate = true;
    controls.autoRotateSpeed = 1.5;
    controls.maxPolarAngle = Math.PI / 2 + 0.05;
    controls.minDistance = 2.0;
    controls.maxDistance = 6.0;

    const ambientLight = new THREE.AmbientLight(0xffffff, 1.6);
    scene.add(ambientLight);

    const keyLight = new THREE.DirectionalLight(0xffffff, 2.2);
    keyLight.position.set(5, 7, 5);
    scene.add(keyLight);

    const redAccentLight = new THREE.PointLight(0xdc2626, 2.0, 10);
    redAccentLight.position.set(-3, 2, -3);
    scene.add(redAccentLight);

    const grid = new THREE.GridHelper(8, 12, 0xfca5a5, 0xe2e8f0);
    grid.position.y = -0.65;
    scene.add(grid);

    const loader = new GLTFLoader();
    const dracoLoader = new DRACOLoader();
    dracoLoader.setDecoderPath('https://www.gstatic.com/draco/versioned/decoders/1.5.7/');
    loader.setDRACOLoader(dracoLoader);

    let currentObject: THREE.Group | null = null;

    function loadModel(url: string) {
      if (loaderElem) loaderElem.classList.remove('hidden');

      if (currentObject) {
        scene.remove(currentObject);
        currentObject = null;
      }

      loader.load(
        url,
        (gltf) => {
          currentObject = gltf.scene;

          const box = new THREE.Box3().setFromObject(currentObject);
          const center = box.getCenter(new THREE.Vector3());
          const size = box.getSize(new THREE.Vector3());
          const maxDim = Math.max(size.x, size.y, size.z);

          currentObject.position.sub(center);
          currentObject.position.y += (size.y / 2) - 0.65;
          const scale = 2.0 / maxDim;
          currentObject.scale.setScalar(scale);

          scene.add(currentObject);
          if (loaderElem) loaderElem.classList.add('hidden');
        },
        undefined,
        (err) => {
          console.error('Error loading vehicle model:', err);
          if (loaderElem) loaderElem.classList.add('hidden');
        }
      );
    }

    loadModel('/models/motorcycle.glb');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        tabs.forEach((t) => {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');

        const modelUrl = tab.dataset.modelUrl || '/models/motorcycle.glb';
        loadModel(modelUrl);

        if (titleElem) titleElem.textContent = tab.dataset.name || '';
        if (descElem) descElem.textContent = tab.dataset.desc || '';
        if (capElem) capElem.textContent = tab.dataset.capacity || '';
        if (speedElem) speedElem.textContent = tab.dataset.speed || '';
        if (fareElem) fareElem.textContent = tab.dataset.fare || '';
        if (badgeText) badgeText.textContent = tab.dataset.name || '';
        if (badgeIcon) {
          const iconImg = tab.querySelector<HTMLImageElement>('.tab-icon');
          if (iconImg) badgeIcon.src = iconImg.src;
        }
      });
    });

    let animId: number;
    function render() {
      animId = requestAnimationFrame(render);
      controls.update();
      renderer.render(scene, camera);
    }
    render();

    const ro = new ResizeObserver(() => {
      if (!stage) return;
      camera.aspect = stage.clientWidth / stage.clientHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(stage.clientWidth, stage.clientHeight);
    });
    ro.observe(stage);

    window.addEventListener('beforeunload', () => {
      cancelAnimationFrame(animId);
      renderer.dispose();
      dracoLoader.dispose();
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initShowcaseViewer);
  } else {
    initShowcaseViewer();
  }
</script>
