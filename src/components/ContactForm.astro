---
import { type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<div class="contact-form-surface surface-panel surface-glow">
  <form id="bataibato-contact-form" class="bataibato-form">
    <div class="form-row">
      <div class="form-field">
        <label for="contact-name" class="field-label">
          {lang === 'ne' ? 'तपाईंको पूरा नाम' : 'Your Full Name'}
        </label>
        <input
          type="text"
          id="contact-name"
          name="name"
          required
          class="field-input"
          placeholder={lang === 'ne' ? 'उदाहरण: राज श्रेष्ठ' : 'e.g. Raj Shrestha'}
        />
      </div>

      <div class="form-field">
        <label for="contact-phone" class="field-label">
          {lang === 'ne' ? 'मोबाइल नम्बर वा इमेल' : 'Mobile Number or Email'}
        </label>
        <input
          type="text"
          id="contact-phone"
          name="contact"
          required
          class="field-input"
          placeholder={lang === 'ne' ? '९८XXXXXXXX वा email@example.com' : '98XXXXXXXX or email@example.com'}
        />
      </div>
    </div>

    <div class="form-field">
      <label for="contact-topic" class="field-label">
        {lang === 'ne' ? 'सम्पर्कको विषय' : 'Topic of Inquiry'}
      </label>
      <select id="contact-topic" name="topic" class="field-input field-select">
        <option value="driver">{lang === 'ne' ? 'चालक दर्ता तथा सहकार्य (Driver Partner)' : 'Driver Registration and Partnership'}</option>
        <option value="rider">{lang === 'ne' ? 'यात्रु सोधपुछ तथा सहयोग (Rider Support)' : 'Rider Assistance and Inquiries'}</option>
        <option value="safety">{lang === 'ne' ? 'सुरक्षा तथा सुझाव (Safety & Feedback)' : 'Safety and Community Feedback'}</option>
        <option value="business">{lang === 'ne' ? 'सिन्धुली व्यावसायिक साझेदारी (Business Partnership)' : 'Commercial Inquiries'}</option>
      </select>
    </div>

    <div class="form-field">
      <label for="contact-message" class="field-label">
        {lang === 'ne' ? 'तपाईंको सन्देश' : 'Your Message'}
      </label>
      <textarea
        id="contact-message"
        name="message"
        rows="4"
        required
        class="field-input field-textarea"
        placeholder={lang === 'ne' ? 'हामीलाई आफ्नो जिज्ञासा वा समस्या खुलाएर लेख्नुहोस्...' : 'Tell us how we can help you...'}
      ></textarea>
    </div>

    <div class="form-submit-row">
      <button type="submit" class="btn btn-primary submit-btn">
        <img src="/icons/ui/mail.svg" alt="" width="18" height="18" />
        <span>{lang === 'ne' ? 'सन्देश पठाउनुहोस्' : 'Send Message'}</span>
      </button>
    </div>

    <div id="form-success-banner" class="form-notice success-notice" hidden>
      <img src="/icons/ui/check.svg" alt="" width="22" height="22" />
      <span>
        {lang === 'ne'
          ? 'धन्यवाद! तपाईंको सन्देश प्राप्त भयो। हाम्रो सिन्धुली टिमले छिट्टै सम्पर्क गर्नेछ।'
          : 'Thank you! Your message has been received. Our team will get back to you shortly.'}
      </span>
    </div>
  </form>
</div>

<style>
  .contact-form-surface {
    padding: clamp(1.75rem, 4vw, 2.75rem);
  }

  .bataibato-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .field-label {
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--bb-gray-light);
  }

  .field-input {
    background: var(--bb-dark-elevated);
    border: 1px solid var(--bb-border);
    border-radius: var(--bb-radius-md);
    padding: 0.85rem 1.15rem;
    color: var(--bb-light);
    font-family: inherit;
    font-size: 1rem;
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .field-input:focus {
    border-color: var(--bb-red-500);
    box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.2);
  }

  .field-select {
    cursor: pointer;
  }

  .field-textarea {
    resize: vertical;
    min-height: 110px;
  }

  .form-submit-row {
    margin-top: 0.5rem;
  }

  .submit-btn {
    width: 100%;
    padding-block: 1rem;
    font-size: 1.05rem;
  }

  .form-notice {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    border-radius: var(--bb-radius-md);
    background: rgba(74, 222, 128, 0.12);
    border: 1px solid rgba(74, 222, 128, 0.35);
    color: #4ade80;
    font-size: 0.95rem;
    font-weight: 500;
  }

  @media (max-width: 650px) {
    .form-row {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const form = document.getElementById('bataibato-contact-form') as HTMLFormElement | null;
  const banner = document.getElementById('form-success-banner');

  if (form && banner) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      form.reset();
      banner.hidden = false;
      setTimeout(() => {
        banner.hidden = true;
      }, 7000);
    });
  }
</script>
