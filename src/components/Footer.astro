---
import { type Lang, useTranslations, getLocalizedPath } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<footer class="site-footer">
  <div class="container footer-content">
    <div class="footer-grid">
      <!-- Col 1: Brand Info -->
      <div class="footer-col brand-col">
        <a href={getLocalizedPath('/', lang)} class="footer-brand">
          <span class="brand-name">Batai<span class="brand-highlight">Bato</span></span>
        </a>
        <p class="footer-desc">
          {t('footer.tagline')}
        </p>
        <div class="sindhuli-location-badge">
          <img src="/icons/ui/map-pin.svg" alt="" width="16" height="16" class="loc-icon" />
          <span>{lang === 'ne' ? 'सिन्धुली, नेपाल' : 'Sindhuli, Nepal'}</span>
        </div>
      </div>

      <!-- Col 2: Navigation Links -->
      <div class="footer-col">
        <h3 class="footer-heading">{t('footer.pages')}</h3>
        <ul class="footer-links">
          <li><a href={getLocalizedPath('/', lang)}>{t('nav.home')}</a></li>
          <li><a href={getLocalizedPath('/features', lang)}>{t('nav.features')}</a></li>
          <li><a href={getLocalizedPath('/how-it-works', lang)}>{t('nav.howItWorks')}</a></li>
          <li><a href={getLocalizedPath('/about', lang)}>{t('nav.about')}</a></li>
          <li><a href={getLocalizedPath('/faq', lang)}>{t('nav.faq')}</a></li>
          <li><a href={getLocalizedPath('/contact', lang)}>{t('nav.contact')}</a></li>
        </ul>
      </div>

      <!-- Col 3: Legal & Safety -->
      <div class="footer-col">
        <h3 class="footer-heading">{t('footer.legal')}</h3>
        <ul class="footer-links">
          <li><a href={getLocalizedPath('/privacy', lang)}>{t('footer.privacy')}</a></li>
          <li><a href={getLocalizedPath('/terms', lang)}>{t('footer.terms')}</a></li>
          <li><a href={getLocalizedPath('/faq', lang)}>{lang === 'ne' ? 'डाटा सुरक्षा तथा गोपनीयता' : 'Data Safety and Deletion'}</a></li>
          <li><a href="https://play.google.com/store/apps/details?id=com.bataibato.app" target="_blank" rel="noopener noreferrer">{lang === 'ne' ? 'गुगल प्ले स्टोर' : 'Google Play Store'}</a></li>
        </ul>
      </div>

      <!-- Col 4: Contact & App Download -->
      <div class="footer-col">
        <h3 class="footer-heading">{t('footer.contactUs')}</h3>
        <p class="footer-address">
          {t('footer.address')}
        </p>
        <p class="footer-email">
          <strong>Email:</strong> support@bataibato.com
        </p>
        <div class="play-badge-wrapper">
          <a href="https://play.google.com/store/apps/details?id=com.bataibato.app" target="_blank" rel="noopener noreferrer" class="play-badge-link" aria-label="Get BataiBato on Google Play">
            <img src="/google-play-badge.svg" alt="Get it on Google Play" width="160" height="48" />
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="footer-bottom">
      <p class="copyright">
        {t('footer.rights')}
      </p>
      <div class="footer-bottom-links">
        <a href={getLocalizedPath('/privacy', lang)}>{t('footer.privacy')}</a>
        <span>•</span>
        <a href={getLocalizedPath('/terms', lang)}>{t('footer.terms')}</a>
        <span>•</span>
        <a href={getLocalizedPath('/faq', lang)}>{t('nav.faq')}</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: #f8fafc;
    border-top: 1px solid var(--bb-border);
    padding-top: 4.5rem;
    padding-bottom: 2.5rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1.2fr 1.8fr;
    gap: 3rem;
    margin-bottom: 3.5rem;
  }

  .brand-name {
    font-size: 1.55rem;
    font-weight: 800;
    color: var(--bb-text);
  }

  .brand-highlight {
    color: var(--bb-red-600);
  }

  .footer-desc {
    color: var(--bb-text-muted);
    font-size: 0.95rem;
    margin-top: 0.85rem;
    line-height: 1.6;
    max-width: 320px;
  }

  .sindhuli-location-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: #ffffff;
    border: 1px solid var(--bb-border);
    padding: 0.35rem 0.8rem;
    border-radius: var(--bb-radius-full);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--bb-text);
    margin-top: 1.25rem;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
  }

  .loc-icon {
    filter: invert(19%) sepia(87%) saturate(5412%) hue-rotate(352deg) brightness(92%) contrast(92%);
  }

  .footer-heading {
    font-size: 1rem;
    font-weight: 700;
    color: var(--bb-text);
    margin-top: 0;
    margin-bottom: 1.25rem;
    letter-spacing: -0.01em;
  }

  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer-links a {
    color: var(--bb-text-muted);
    font-size: 0.92rem;
    transition: color 0.2s ease, transform 0.2s ease;
    display: inline-block;
  }

  .footer-links a:hover {
    color: var(--bb-red-600);
    transform: translateX(3px);
  }

  .footer-address, .footer-email {
    color: var(--bb-text-muted);
    font-size: 0.92rem;
    line-height: 1.6;
    margin-bottom: 0.5rem;
  }

  .play-badge-wrapper {
    margin-top: 1.25rem;
  }

  .play-badge-link {
    display: inline-block;
    transition: transform 0.2s ease;
  }

  .play-badge-link:hover {
    transform: scale(1.04);
  }

  .footer-bottom {
    border-top: 1px solid var(--bb-border);
    padding-top: 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .copyright {
    color: var(--bb-text-muted);
    font-size: 0.88rem;
    margin: 0;
  }

  .footer-bottom-links {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.88rem;
    color: var(--bb-text-muted);
  }

  .footer-bottom-links a {
    color: var(--bb-text-muted);
    transition: color 0.2s;
  }

  .footer-bottom-links a:hover {
    color: var(--bb-red-600);
  }

  @media (max-width: 992px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem;
    }
  }

  @media (max-width: 576px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
