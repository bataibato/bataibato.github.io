---
import PageLayout from '../../layouts/PageLayout.astro';
import { useTranslations } from '../../i18n/ui';

const lang = 'en';
const t = useTranslations(lang);
---

<PageLayout
  title="Download BataiBato App | Google Play Store"
  description="Download the official BataiBato Android application. Package: com.bataibato.app. Fast motorcycle, scooter, auto rickshaw, and car ride sharing in Sindhuli, Nepal."
  lang={lang}
>
  <section class="section download-hero-section">
    <div class="container text-center">
      <h1 class="heading-xl">
        Get <span class="text-gradient">BataiBato</span> on Your Smartphone
      </h1>
      <p class="lead-text text-muted" style="max-width: 650px; margin: 1.5rem auto 0;">
        Install from Google Play Store today and join thousands of Sindhuli commuters enjoying modern, community centered travel.
      </p>

      <!-- Big Download Cluster -->
      <div class="download-main-hub surface-panel surface-glow" style="margin-top: 3.5rem; max-width: 820px; margin-inline: auto;">
        <div class="hub-grid">
          <div class="hub-left">
            <h2 class="heading-md" style="margin-top: 0;">For Android Smartphones</h2>
            <p class="text-muted" style="margin-top: 0.5rem; line-height: 1.6;">
              Tap the official Google Play badge to open the store listing directly, or scan the QR code with your camera.
            </p>

            <div class="hub-badges-row">
              <a
                href="https://play.google.com/store/apps/details?id=com.bataibato.app"
                target="_blank"
                rel="noopener noreferrer"
                class="play-hero-btn"
                aria-label="Download BataiBato on Google Play Store"
              >
                <img src="/google-play-badge.svg" alt="Get it on Google Play" width="200" height="60" />
              </a>
            </div>

            <div class="hub-tech-specs">
              <div class="spec-bullet">
                <strong>Package ID:</strong> <code>com.bataibato.app</code>
              </div>
              <div class="spec-bullet">
                <strong>OS Requirement:</strong> Android 7.0 or higher
              </div>
              <div class="spec-bullet">
                <strong>License:</strong> Free Installation
              </div>
            </div>
          </div>

          <div class="hub-right">
            <div class="qr-presentation-box">
              <div class="qr-white-plate">
                <svg viewBox="0 0 100 100" width="160" height="160" fill="#ffffff">
                  <rect width="100" height="100" fill="#ffffff" rx="6" />
                  <path d="M10 10h30v30H10zm6 6v18h18V16zm4 4h10v10H20zM60 10h30v30H60zm6 6v18h18V16zm4 4h10v10H70zM10 60h30v30H10zm6 6v18h18V66zm4 4h10v10H20zM50 20h6v6h-6zm0 14h6v6h-6zm10 20h6v6h-6zm14 0h16v6H74zm-24 10h6v10h-6zm10 6h10v6H60zm16 4h14v10H76zm-16 10h6v10h-6zm20 0h10v10H80z" fill="#0a0a0a"/>
                </svg>
              </div>
              <span class="qr-hint text-muted">Scan using mobile camera or Google Lens</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- iOS Teaser Section -->
  <section class="section ios-teaser-section" style="padding-top: 0;">
    <div class="container container-narrow text-center">
      <div class="ios-notice-box surface-panel">
        <h3 class="heading-md" style="margin-top: 0; margin-bottom: 0.5rem;">Apple iOS Version: Coming Soon to the Apple App Store</h3>
        <p class="text-muted" style="margin: 0 auto; max-width: 520px; line-height: 1.6;">
          Our iOS build is undergoing testing. iPhone support across Sindhuli and regional routes will be released soon.
        </p>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .download-hero-section {
    padding-top: 8rem;
    padding-bottom: 4rem;
  }

  .dot-live {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #4ade80;
    box-shadow: 0 0 8px #4ade80;
  }

  .hub-grid {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    gap: 3rem;
    align-items: center;
    text-align: left;
    padding: clamp(1.5rem, 4vw, 3rem);
  }

  .hub-badges-row {
    margin-top: 1.5rem;
    margin-bottom: 2rem;
  }

  .play-hero-btn {
    display: inline-block;
    transition: transform 0.2s ease;
  }

  .play-hero-btn:hover {
    transform: scale(1.04);
  }

  .hub-tech-specs {
    border-top: 1px solid var(--bb-border);
    padding-top: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.92rem;
    color: var(--bb-gray-light);
  }

  .hub-tech-specs code {
    background: var(--bb-dark-elevated);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    color: var(--bb-red-400);
    font-family: monospace;
  }

  .hub-right {
    display: flex;
    justify-content: center;
  }

  .qr-presentation-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .qr-white-plate {
    background: #ffffff;
    padding: 1rem;
    border-radius: var(--bb-radius-md);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.4);
  }

  .qr-hint {
    font-size: 0.85rem;
    text-align: center;
  }

  .ios-notice-box {
    padding: 2.5rem 2rem;
    border-style: solid;
  }

  @media (max-width: 800px) {
    .hub-grid {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .hub-left {
      display: flex;
      flex-direction: column;
      align-items: center;
    }
  }
</style>
